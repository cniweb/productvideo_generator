# Fülle alle erforderlichen Variablen aus, bevor du den Generator startest.
# API Keys
GEMINI_API_KEY=dein_gemini_key_hier

# Kanal Einstellungen
CHANNEL_NAME="Gadget Review Kanal"
CHANNEL_DESCRIPTION="Wir testen die neuesten Gadgets und geben ehrliche Kaufempfehlungen."

# Pfade
VIDEO_OUTPUT_DIR=finished_videos

# Video Modelle
VIDEO_MODEL=veo-3.1-generate-preview
VIDEO_FALLBACK_MODEL=veo-3.1-fast-generate-preview
